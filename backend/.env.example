# Copy this file to backend/.env and fill in your values. backend/.env is gitignored.

# One Groq key, or several separated by commas. The API rotates through them and
# temporarily parks a key that is rate-limited (429) or rejected (401/403).
GROQ_API_KEYS=gsk_your_first_key,gsk_your_second_key

# Optional overrides
# HIREHEARSAL_LLM_MODEL=openai/gpt-oss-120b
# HIREHEARSAL_LLM_REASONING_EFFORT=low
# HIREHEARSAL_JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-bytes
# HIREHEARSAL_CORS_ORIGINS=http://localhost:3000
# PORT=8085
